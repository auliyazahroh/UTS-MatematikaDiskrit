#Pivot
vowels = set("aeiouAEIOU")
def count_vowels_consonants(w):
    letters = [ch for ch in w if ch.isalpha()]
    v = sum(ch in vowels for ch in letters)
    c = sum(ch.isalpha() and ch not in vowels for ch in letters)
    return v, c
words = re.findall(r"[A-Za-z]+(?:'[A-Za-z]+)?", text)
rows = []
for w in words:
    v, c = count_vowels_consonants(w)
    rows.append({"word": w.lower(), "vowels": v, "consonants": c})
df = pd.DataFrame(rows)
df["freq"] = df.groupby("word")["word"].transform("count")
#Pivot Frekuensi Kata
pivot_freq = (df.groupby(["consonants","vowels"])["freq"]
                .sum().reset_index()
                .pivot(index="vowels", columns="consonants", values="freq")
                .fillna(0).astype(int))
display(pivot_freq)
#Pivot Jumlah Kata Unik
pivot_unique = (df.drop_duplicates("word")
